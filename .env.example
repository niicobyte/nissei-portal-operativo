# Configuración de WhaApi (Whapi.cloud) — Copiar a .env.local (nunca subir .env.local a Git)
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_API_TOKEN=tu_token_whapi_aqui

# Grupos de WhatsApp específicos por sector SATI (IDs privados en .env.local)
WHAPI_GROUP_MONTAJES=tu_id_grupo_montajes@g.us
WHAPI_GROUP_RECEPCION=tu_id_grupo_recepcion@g.us
WHAPI_GROUP_TALLER=tu_id_grupo_taller@g.us
WHAPI_FEEDBACK_GROUP=tu_id_grupo_feedback@g.us

# Conexión a Base de Datos MySQL (Docker / Servidor)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tu_usuario_mysql
MYSQL_PASSWORD=tu_password_aqui
MYSQL_DATABASE=nissei_portal
